# Copy to .env only if your shell/loader supports it; the CLI reads plain
# environment variables and never requires a .env file.

# Loopback game-adapter WebSocket.
MCBOT_ADAPTER_URL=ws://127.0.0.1:8765

# Bot identity and state.
MCBOT_USERNAME=MCBot
MCBOT_STATE_DIR=./state

# Logging: debug | info | warn | error.
MCBOT_LOG_LEVEL=info

# Planner: deterministic | qwen. Qwen is optional and falls back automatically.
MCBOT_PLANNER_MODE=deterministic
MCBOT_QWEN_BASE_URL=http://127.0.0.1:11434/v1
MCBOT_QWEN_MODEL=qwen2.5:14b-instruct

# Name of the environment variable holding the Qwen API key (if any).
# The value is read at request time and never written to logs or checkpoints.
MCBOT_QWEN_API_KEY_ENV=QWEN_API_KEY

# Live-server safety. Keep remote adapters disabled for the MVP.
MCBOT_ALLOW_REMOTE_ADAPTER=0
MCBOT_SERVER_WHITELIST=127.0.0.1:25565,localhost:25565
